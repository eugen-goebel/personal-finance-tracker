# Copy this file to .env and adjust the values. The dashboard and the API
# load it on startup, and real environment variables take precedence over it.
# Everything runs locally, no API keys needed.

# Database location (default: sqlite:///finance.db)
# DATABASE_URL=sqlite:///finance.db

# Budget alert emails. Without SMTP_HOST, SMTP_USER and ALERT_RECIPIENT the
# alert service stays switched off and only records breaches in the database.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# ALERT_RECIPIENT=you@example.com
